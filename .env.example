# Copy to `.env`. You do NOT need any of this to complete the assignment --
# the default runtime is fully offline.

# replay (default) | live | record
#   replay : no network, no key. Model calls served from fixtures/llm.json.
#   live   : real calls. Needs LLM_API_KEY.
#   record : real calls, and each response is appended to the cassette.
LLM_MODE=replay

# replay (default) | live
#   live performs real web searches and real HTTP fetches.
TOOLS_MODE=replay

# Only read when LLM_MODE is live or record. Any OpenAI-compatible endpoint
# works: OpenRouter, OpenAI, Together, a local vLLM or Ollama server.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
